# Host do AEM usado pelo servidor Next para buscar conteúdo (author local).
AEM_HOST=http://localhost:4502
# Credenciais "user:password" para o author local (SDK). Nunca use credenciais reais aqui.
AEM_AUTH=admin:admin

# Universal Editor: author acessado via HTTPS (local-ssl-proxy) e UES local.
NEXT_PUBLIC_AEM_UE_HOST=https://localhost:8443
NEXT_PUBLIC_UE_SERVICE=https://localhost:8000
